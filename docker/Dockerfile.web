FROM python:3.11-slim

WORKDIR /app

ENV PYTHONPATH=/app

# Install Poetry
RUN pip install poetry==1.7.1

# Copy only dependency files first for better caching
COPY pyproject.toml poetry.lock* /app/

# Configure Poetry to not use a virtual environment, and install SERIALLY.
#
# With virtualenvs.create false, Poetry installs every package into the same
# site-packages that each of its `pip` subprocesses imports from, and by default
# it runs those subprocesses in parallel. attrs and cffi are both dependency
# leaves, so they land in the same batch: while one worker is still extracting
# attrs 25.4.0, another starts `pip install cffi`, pip's vendored rich runs
# `import attr`, gets a half-written package (_make.py present, setters.py not
# yet complete) and dies with
#   AttributeError: module 'attr.setters' has no attribute 'pipe'
#   -> Cannot install cffi
# rich guards that import with `except ImportError` only, so a partial package
# is fatal rather than skipped. It is a race, which is why worker and gleaming
# passed on the same commit while web failed -- twice (15d4e08, 9bff72c), each
# time on a build with no cached install layer. Serial install removes the race;
# it costs time only when this layer is rebuilt.
RUN poetry config virtualenvs.create false \
    && poetry config installer.parallel false \
    && poetry install --no-interaction --no-ansi

# Copy rest of the source code (bust cache v2)
COPY . /app/

# Pipeline stdout must reach the log line by line. Without this, Python block-buffers
# stdout when it is not a tty -- which it never is in a container -- so a phase banner
# like `[4.5/10] DCF Engine` sits in the buffer until something flushes it. When the
# container is replaced mid-run the buffer is lost with it, and the phase that DID
# execute leaves no trace in the log. That is not hypothetical: an EL run killed 25 s
# into phase 4.5 published `dcf_engine` to Redis (so the UI showed "Computing the
# valuation model") but never printed its banner, and the post-mortem had to be
# reconstructed from the frontend source to prove the phase had run at all.
# PYTHONUNBUFFERED=1 is the whole fix; `-u` on the CMD would only cover the processes
# these Dockerfiles name, not the ones START_CMD substitutes at runtime.
#
# ITS POSITION IS LOAD-BEARING -- do not "tidy" this above the dependency layers.
# A layer's cache key is its own instruction text plus every layer before it, so an
# ENV sitting above `RUN poetry install` invalidates the install and forces a full
# dependency reinstall on the next build. That is not merely a slow build here: this
# line originally sat above the install, and because railway.toml points EVERY service
# at this one file, all three reinstalled from scratch at the same moment. The web
# build died inside pip with
# `AttributeError: module 'attr.setters' has no attribute 'pipe'` -> `Cannot install
# cffi` -- the parallel-install race explained at the `poetry install` layer above
# (not an old attrs: the lock pins 25.4.0). Worker and gleaming ran the identical
# reinstall and passed because a race does not fire every time -- but the EXPOSURE came from the layer position, not from any
# dependency change, and web was left serving the previous build. Below `COPY . /app/`
# it invalidates only layers that every commit invalidates anyway, and it is still in
# the final image's environment, which is all the runtime needs.
ENV PYTHONUNBUFFERED=1

ENV PORT=8000
EXPOSE 8000

# Railway sets PORT dynamically — use shell form so $PORT is expanded at runtime.
# START_CMD branches per service (one railway.toml serves all services, and the
# dashboard start-command field proved unreliable): web leaves it unset and
# runs uvicorn; the worker service sets START_CMD=python -m app.backend.worker_main
# and the scheduler service sets START_CMD=python -m app.backend.scheduler_service
# in their Variables (both start the $PORT health responder first).
CMD sh -c "${START_CMD:-uvicorn app.backend.main:app --host 0.0.0.0 --port $PORT}"
