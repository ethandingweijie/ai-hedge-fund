FROM python:3.11-slim

WORKDIR /app

ENV PYTHONPATH=/app

# Install Poetry
RUN pip install poetry==1.7.1

# Copy only dependency files first for better caching
COPY pyproject.toml poetry.lock* /app/

# Configure Poetry to not use a virtual environment
RUN poetry config virtualenvs.create false \
    && poetry install --no-interaction --no-ansi

# Copy rest of the source code (bust cache v2)
COPY . /app/

ENV PORT=8000
EXPOSE 8000

# Railway sets PORT dynamically — use shell form so $PORT is expanded at runtime.
# START_CMD branches per service (one railway.toml serves all services, and the
# dashboard start-command field proved unreliable): web leaves it unset and
# runs uvicorn; the worker service sets START_CMD=python -m app.backend.worker_main
# and the scheduler service sets START_CMD=python -m app.backend.scheduler_service
# in their Variables (both start the $PORT health responder first).
CMD sh -c "${START_CMD:-uvicorn app.backend.main:app --host 0.0.0.0 --port $PORT}"
